APP_NAME=lambda-orchestrator
NODE_ENV=development
STAGE=dev
PORT=3003

CUSTOMERS_API_BASE_URL=http://customers-api:3001
ORDERS_API_BASE_URL=http://orders-api:3002
CUSTOMERS_API_TIMEOUT_MS=5000
ORDERS_API_TIMEOUT_MS=5000

# Must match customers-api's SERVICE_TOKEN (used to call GET /internal/customers/:id)
SERVICE_TOKEN=internal-service-token

# Must match orders-api's AUTH_USERNAME / AUTH_PASSWORD — the orchestrator logs in
# against orders-api's /auth/login to obtain a JWT before calling /orders
ORDERS_API_AUTH_USERNAME=admin
ORDERS_API_AUTH_PASSWORD=admin123

LOG_LEVEL=info
